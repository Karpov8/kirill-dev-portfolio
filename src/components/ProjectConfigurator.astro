---
import { portfolio, resolveTelegramUsername } from "../data/portfolio";

const { configurator, contacts } = portfolio;
const telegramUsername = resolveTelegramUsername(contacts.telegramUsername, contacts.telegramUrl);
const groups = configurator.groups.map((group) => ({
  ...group,
  options: (group.options as readonly string[]).includes("Не знаю")
    ? group.options
    : [...group.options, "Не знаю"],
}));
---

<section
  class="configurator-section"
  id="configurator"
  aria-labelledby="configurator-title"
  data-configurator
  data-telegram-username={telegramUsername}
>
  <header class="section-heading">
    <p class="section-kicker">Архитектура проекта</p>
    <h2 id="configurator-title">{configurator.title}</h2>
    <p>{configurator.subtitle}</p>
  </header>

  <form class="configurator-layout" data-configurator-form action="#configurator">
    <div class="configurator-steps">
      {groups.map((group, groupIndex) => (
        <fieldset data-config-group={group.id}>
          <legend>
            <span>{String(groupIndex + 1).padStart(2, "0")}</span>
            {group.label}
          </legend>
          <p class="group-help">Можно выбрать несколько вариантов.</p>
          <div class="option-grid">
            {group.options.map((option, optionIndex) => {
              const inputId = `config-${group.id}-${optionIndex}`;
              return (
                <label class:list={["config-option", { "config-option--unknown": option === "Не знаю" }]} for={inputId}>
                  <input
                    id={inputId}
                    type="checkbox"
                    name={group.id}
                    value={option}
                    data-config-option
                    data-unknown={option === "Не знаю" ? "true" : undefined}
                  />
                  <span>{option}</span>
                </label>
              );
            })}
          </div>
        </fieldset>
      ))}

      <p class="config-error" data-config-error role="alert" hidden>
        Выберите хотя бы один вариант в каждом разделе. Если не уверены, отметьте «Не знаю».
      </p>
    </div>

    <aside class="config-preview" aria-labelledby="config-preview-title">
      <div class="preview-head">
        <span>Предварительная схема</span>
        <output data-config-complexity>Не рассчитана</output>
      </div>
      <h3 id="config-preview-title">Архитектура проекта</h3>

      <ol class="architecture" data-config-architecture>
        {groups.map((group) => (
          <li data-architecture-stage={group.id}>
            <span>{group.label}</span>
            <strong>Выберите вариант</strong>
          </li>
        ))}
      </ol>

      <p class="config-summary" data-config-summary aria-live="polite">
        Выберите элементы слева — здесь появится понятное описание будущей системы.
      </p>

      <div class="price-guide">
        <span>Ориентиры</span>
        <ul>
          {configurator.priceGuides.map((guide) => <li>{guide}</li>)}
        </ul>
        <p>{configurator.disclaimer}</p>
      </div>

      <div class="preview-actions">
        <button class="primary-button" type="submit">{configurator.cta}</button>
        <button class="secondary-button" type="button" data-config-copy>
          Скопировать конфигурацию
        </button>
      </div>
      <p class="config-status" data-config-status role="status" aria-live="polite"></p>
    </aside>
  </form>
</section>

<style>
  .configurator-section {
    width: min(calc(100% - 48px), 1320px);
    margin-inline: auto;
    padding: clamp(80px, 10vw, 144px) 0;
    scroll-margin-top: 88px;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .section-kicker {
    margin: 0 0 14px;
    color: var(--cyan, #00e5ff);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--text-primary, #f5f7fa);
    font-size: clamp(42px, 5.5vw, 74px);
    line-height: 1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .section-heading > p:last-child {
    max-width: 680px;
    margin: 22px 0 0;
    color: var(--text-secondary, #9299a5);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.6;
  }

  .configurator-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.88fr);
    align-items: start;
    gap: clamp(24px, 4vw, 52px);
  }

  .configurator-steps {
    display: grid;
    gap: 14px;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 18px;
    background: var(--surface, rgba(255, 255, 255, 0.035));
  }

  legend {
    padding: 0 8px;
    color: var(--text-primary, #f5f7fa);
    font-size: 18px;
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  legend span {
    margin-right: 9px;
    color: var(--cyan, #00e5ff);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 11px;
    font-weight: 500;
  }

  .group-help {
    margin: 0 0 15px;
    color: var(--text-secondary, #9299a5);
    font-size: 13px;
  }

  .option-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .config-option {
    cursor: pointer;
  }

  .config-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .config-option span {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 11px;
    color: var(--text-secondary, #9299a5);
    background: color-mix(in srgb, var(--background, #050505) 42%, transparent);
    font-size: 14px;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .config-option input:checked + span {
    color: var(--text-primary, #f5f7fa);
    border-color: var(--border-hover, rgba(0, 229, 255, 0.28));
    background: color-mix(in srgb, var(--cyan, #00e5ff) 9%, transparent);
  }

  .config-option input:focus-visible + span {
    outline: 2px solid var(--cyan, #00e5ff);
    outline-offset: 3px;
  }

  .config-option--unknown span {
    border-style: dashed;
  }

  .config-preview {
    position: sticky;
    top: 96px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--border-hover, rgba(0, 229, 255, 0.28));
    border-radius: 22px;
    background: color-mix(in srgb, var(--background-secondary, #090a0c) 95%, transparent);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.35);
  }

  .preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--text-secondary, #9299a5);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview-head output {
    padding: 6px 9px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 999px;
    color: var(--cyan, #00e5ff);
  }

  .config-preview h3 {
    margin: 18px 0 0;
    color: var(--text-primary, #f5f7fa);
    font-size: clamp(25px, 3vw, 36px);
    letter-spacing: -0.04em;
  }

  .architecture {
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    list-style: none;
  }

  .architecture li {
    position: relative;
    padding: 14px 0 14px 20px;
    display: grid;
    gap: 5px;
    border-left: 1px solid color-mix(in srgb, var(--cyan, #00e5ff) 36%, transparent);
  }

  .architecture li:first-child {
    padding-top: 0;
  }

  .architecture li:last-child {
    padding-bottom: 0;
  }

  .architecture span {
    color: var(--text-secondary, #9299a5);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .architecture strong {
    color: var(--text-primary, #f5f7fa);
    font-size: 14px;
    line-height: 1.4;
  }

  .config-summary {
    margin: 26px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    color: var(--text-primary, #f5f7fa);
    line-height: 1.65;
  }

  .price-guide {
    margin-top: 24px;
    padding: 18px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 14px;
    background: var(--surface, rgba(255, 255, 255, 0.035));
  }

  .price-guide > span {
    color: var(--text-primary, #f5f7fa);
    font-weight: 650;
  }

  .price-guide ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--text-secondary, #9299a5);
    font-size: 13px;
    line-height: 1.65;
  }

  .price-guide p {
    margin: 13px 0 0;
    color: var(--text-secondary, #9299a5);
    font-size: 12px;
    line-height: 1.55;
  }

  .preview-actions {
    margin-top: 22px;
    display: grid;
    gap: 9px;
  }

  .primary-button,
  .secondary-button {
    min-height: 50px;
    padding-inline: 18px;
    border-radius: 13px;
    font: inherit;
    font-weight: 680;
    cursor: pointer;
  }

  .primary-button {
    border: 1px solid var(--text-primary, #f5f7fa);
    color: var(--background, #050505);
    background: var(--text-primary, #f5f7fa);
  }

  .secondary-button {
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    color: var(--text-primary, #f5f7fa);
    background: transparent;
  }

  .config-error,
  .config-status {
    color: var(--warning, #f5b942);
    font-size: 13px;
    line-height: 1.5;
  }

  .config-error {
    margin: 4px 0 0;
  }

  .config-error[hidden] {
    display: none;
  }

  .config-status {
    min-height: 20px;
    margin: 12px 0 0;
  }

  @media (max-width: 980px) {
    .configurator-layout {
      grid-template-columns: 1fr;
    }

    .config-preview {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .configurator-section {
      width: min(calc(100% - 32px), 1320px);
    }

    .option-grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    .config-option span {
      width: 100%;
    }

    .preview-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .config-option span {
      transition-duration: 0.01ms;
    }
  }
</style>
