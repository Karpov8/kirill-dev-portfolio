---
import { portfolio } from "../data/portfolio";

const { profile, nav } = portfolio;
---

<div class="page-progress" data-page-progress aria-hidden="true"></div>

<header class="site-header" data-site-header id="top">
  <div class="header-inner">
    <a class="brand" href="#top" aria-label={`${profile.brand} — на главную`}>
      <span class="brand-mark" aria-hidden="true">KD</span>
      <span>{profile.brand}</span>
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      {nav.map((item) => (
        <a href={item.href} data-nav-link>{item.label}</a>
      ))}
    </nav>

    <a class="header-cta" href="#contact" data-project-type="Другое">
      Обсудить проект
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Открыть меню"
      data-menu-toggle
    >
      <span data-menu-label>Меню</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Мобильная навигация">
      {nav.map((item) => (
        <a href={item.href} data-nav-link>{item.label}</a>
      ))}
      <a class="mobile-menu-cta" href="#contact" data-project-type="Другое">
        Обсудить проект
      </a>
    </nav>
  </div>
</header>

<script>
  import "../scripts/interactions.ts";
</script>

<style>
  .page-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 120;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan, #00e5ff), var(--blue, #3478ff));
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left center;
    pointer-events: none;
  }

  .site-header {
    position: fixed;
    inset: 16px 24px auto;
    z-index: 110;
    padding: 9px 16px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 13px;
    background: color-mix(in srgb, var(--background, #050505) 72%, transparent);
    backdrop-filter: blur(18px);
    transition:
      padding 180ms ease,
      inset 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .site-header.is-compact,
  .site-header.is-menu-open {
    inset-block-start: 8px;
    padding-block: 6px;
    background: color-mix(in srgb, var(--background, #050505) 90%, transparent);
    border-color: color-mix(in srgb, var(--cyan, #00e5ff) 16%, var(--border, rgba(255, 255, 255, 0.08)));
  }

  .header-inner {
    width: min(100%, 1320px);
    min-height: 48px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary, #f5f7fa);
    font-weight: 680;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-hover, rgba(0, 229, 255, 0.28));
    border-radius: 10px;
    color: var(--cyan, #00e5ff);
    background: var(--surface, rgba(255, 255, 255, 0.035));
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 12px;
  }

  .desktop-nav {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
  }

  .desktop-nav a,
  .mobile-menu a {
    color: var(--text-secondary, #9299a5);
    font-size: 14px;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .desktop-nav a.is-active,
  .mobile-menu a:hover,
  .mobile-menu a:focus-visible,
  .mobile-menu a.is-active {
    color: var(--text-primary, #f5f7fa);
  }

  .desktop-nav a.is-active {
    text-decoration: underline;
    text-decoration-color: var(--cyan, #00e5ff);
    text-underline-offset: 8px;
  }

  .header-cta,
  .mobile-menu-cta {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
    border-radius: 12px;
    color: var(--text-primary, #f5f7fa);
    background: color-mix(in srgb, var(--surface, rgba(255, 255, 255, 0.035)) 92%, transparent);
    font-weight: 650;
    text-decoration: none;
  }

  .menu-toggle {
    min-width: 54px;
    min-height: 44px;
    display: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    color: var(--text-primary, #f5f7fa);
    background: var(--surface, rgba(255, 255, 255, 0.035));
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .mobile-menu {
    width: min(calc(100% - 32px), 520px);
    margin: 8px auto 0;
    padding: 10px;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 16px;
    background: color-mix(in srgb, var(--background-secondary, #090a0c) 96%, transparent);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.42);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu nav {
    display: grid;
    gap: 2px;
  }

  .mobile-menu a {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding-inline: 14px;
    border-radius: 10px;
  }

  .mobile-menu .mobile-menu-cta {
    margin-top: 8px;
    color: var(--text-primary, #f5f7fa);
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 980px) {
    .site-header {
      inset: 8px 8px auto;
      padding: 8px 10px;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .desktop-nav a,
    .mobile-menu a {
      transition-duration: 0.01ms;
    }
  }
</style>
