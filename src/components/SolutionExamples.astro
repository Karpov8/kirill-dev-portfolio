---
import { portfolio } from "../data/portfolio";

const { solutions } = portfolio;
const projectTypes = {
  portal: "Личный кабинет",
  crm: "CRM",
  bot: "Telegram-бот",
  automation: "Автоматизация",
} as const;
---

<section class="solutions" id="solutions" aria-labelledby="solutions-title">
  <div class="section-inner">
    <header class="section-heading" data-reveal>
      <h2 id="solutions-title">{solutions.title}</h2>
      <p>{solutions.subtitle}</p>
      <small>{solutions.disclaimer}</small>
    </header>

    <div class="solutions-grid">
      {solutions.items.map((solution) => (
        <article class="solution-card" data-reveal>
          <div class="solution-copy">
            <span>{solution.label}</span>
            <h3>{solution.title}</h3>
            <p>{solution.description}</p>
          </div>

          <div class:list={["solution-preview", `solution-preview--${solution.type}`]} aria-hidden="true">
            {solution.type === "portal" && (
              <div class="portal-shell">
                <nav>
                  <strong>KD / клиент</strong>
                  {solution.mockup.navigation.map((item) => <span>{item}</span>)}
                </nav>
                <div class="portal-main">
                  <div class="mockup-toolbar"><span>{solution.mockup.title}</span><i>{solution.mockup.status}</i></div>
                  <div class="portal-metrics"><b>Заявки <strong>3</strong></b><b>Документы <strong>4</strong></b><b>Оплаты <strong>2</strong></b></div>
                  <div class="portal-progress"><span>Прогресс выполнения</span><strong>{solution.mockup.progress}</strong><i><b></b></i></div>
                </div>
              </div>
            )}

            {solution.type === "crm" && (
              <div class="crm-shell">
                <div class="mockup-toolbar"><span>CRM / Воронка</span><i>12 активных</i></div>
                <div class="crm-controls">{solution.mockup.controls.map((item) => <span>{item}</span>)}</div>
                <div class="crm-columns">
                  {solution.mockup.columns.map((column, index) => (
                    <div><span>{column.title}</span><strong>{column.count}</strong><i class:list={[{ active: index === 1 }]}></i><i></i></div>
                  ))}
                </div>
              </div>
            )}

            {solution.type === "bot" && (
              <div class="phone-shell">
                <div class="phone-head"><span>business_bot</span><i>онлайн</i></div>
                <p>{solution.mockup.firstMessage}</p>
                <div class="bot-options">{solution.mockup.options.map((item) => <span>{item}</span>)}</div>
                <p>{solution.mockup.secondMessage}</p>
                <p class="bot-success">{solution.mockup.finalMessage}</p>
              </div>
            )}

            {solution.type === "automation" && (
              <div class="automation-shell">
                <div class="mockup-toolbar"><span>Сценарий / активен</span><i>Обработка заявки</i></div>
                <ol>
                  {solution.mockup.nodes.map((node, index) => (
                    <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{node}</strong><i></i></li>
                  ))}
                </ol>
              </div>
            )}
          </div>

          <a
            class="solution-cta"
            href="#contact"
            data-project-type={projectTypes[solution.type]}
            data-service-name={solution.title}
          >{solution.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .solutions { overflow: clip; }
  .section-heading small { max-width: 42rem; color: var(--kd-color-text-muted); line-height: 1.5; }
  .solutions-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .solution-card { min-width: 0; padding: clamp(1.2rem, 2.8vw, 2rem); display: grid; grid-template-rows: auto minmax(19rem, 1fr) auto; gap: 1.4rem; border: 1px solid var(--kd-color-border-subtle); border-radius: var(--kd-radius-xl); background: var(--kd-color-background-surface); overflow: hidden; }
  .solution-copy > span { color: var(--kd-color-text-accent); font-family: var(--kd-font-mono); font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; }
  .solution-copy h3 { margin-top: .7rem; font-size: clamp(1.5rem, 3vw, 2.1rem); letter-spacing: -.04em; }
  .solution-copy p { max-width: 38rem; margin-top: .7rem; color: var(--kd-color-text-secondary); line-height: 1.6; }
  .solution-preview { min-width: 0; padding: clamp(.8rem, 2vw, 1.25rem); border: 1px solid var(--kd-color-border-default); border-radius: var(--kd-radius-lg); background: var(--kd-color-background-page); overflow: hidden; }
  .mockup-toolbar, .phone-head { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .mockup-toolbar span, .phone-head span { color: var(--kd-color-text-primary); font-size: .78rem; font-weight: 650; }
  .mockup-toolbar i, .phone-head i { color: var(--kd-color-status-success); font-family: var(--kd-font-mono); font-size: .62rem; font-style: normal; }
  .portal-shell { height: 100%; display: grid; grid-template-columns: 8.5rem 1fr; }
  .portal-shell nav { padding: .9rem; display: flex; flex-direction: column; gap: .55rem; border-right: 1px solid var(--kd-color-border-subtle); }
  .portal-shell nav strong { margin-bottom: .55rem; color: var(--kd-color-text-accent); font-family: var(--kd-font-mono); font-size: .66rem; }
  .portal-shell nav span { padding: .38rem .5rem; border-radius: .35rem; color: var(--kd-color-text-muted); font-size: .65rem; }
  .portal-shell nav span:nth-child(3) { color: var(--kd-color-text-primary); background: rgb(64 215 232 / 9%); }
  .portal-main { padding: 1rem; }
  .portal-metrics { margin-top: 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: .45rem; }
  .portal-metrics b { padding: .65rem; border: 1px solid var(--kd-color-border-subtle); border-radius: .5rem; color: var(--kd-color-text-muted); font-size: .61rem; font-weight: 500; }
  .portal-metrics strong { display: block; margin-top: .4rem; color: var(--kd-color-text-primary); font-size: 1rem; }
  .portal-progress { margin-top: 1rem; padding: .8rem; border: 1px solid var(--kd-color-border-subtle); border-radius: .5rem; font-size: .68rem; }
  .portal-progress > strong { float: right; color: var(--kd-color-text-accent); }
  .portal-progress > i { height: .25rem; margin-top: .65rem; display: block; border-radius: 1rem; background: var(--kd-color-border-subtle); overflow: hidden; }
  .portal-progress > i b { width: 68%; height: 100%; display: block; background: var(--kd-color-text-accent); }
  .crm-controls { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .35rem; }
  .crm-controls span { padding: .35rem .55rem; border: 1px solid var(--kd-color-border-subtle); border-radius: .4rem; color: var(--kd-color-text-muted); font-size: .62rem; }
  .crm-columns { margin-top: .8rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; }
  .crm-columns > div { min-height: 10rem; padding: .65rem; border: 1px solid var(--kd-color-border-subtle); border-radius: .55rem; }
  .crm-columns span, .crm-columns strong { font-size: .65rem; }
  .crm-columns strong { float: right; color: var(--kd-color-text-accent); }
  .crm-columns i { height: 2.3rem; margin-top: .7rem; display: block; border: 1px solid var(--kd-color-border-subtle); border-radius: .4rem; background: rgb(255 255 255 / 2%); }
  .crm-columns i.active { border-color: rgb(64 215 232 / 30%); }
  .solution-preview--bot { display: grid; place-items: center; }
  .phone-shell { width: min(100%, 18rem); padding: .9rem; border: 1px solid var(--kd-color-border-default); border-radius: 1.4rem; background: var(--kd-color-background-surface); box-shadow: 0 1rem 3rem rgb(0 0 0 / 30%); }
  .phone-shell p { max-width: 85%; margin-top: .75rem; padding: .55rem .7rem; border-radius: .7rem .7rem .7rem .2rem; color: var(--kd-color-text-secondary); background: rgb(255 255 255 / 5%); font-size: .68rem; }
  .phone-shell p.bot-success { margin-left: auto; color: var(--kd-color-text-primary); background: rgb(64 215 232 / 11%); border-radius: .7rem .7rem .2rem .7rem; }
  .bot-options { margin-top: .55rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: .3rem; }
  .bot-options span { padding: .4rem; border: 1px solid rgb(64 215 232 / 20%); border-radius: .4rem; color: var(--kd-color-text-accent); font-size: .58rem; text-align: center; }
  .automation-shell ol { margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem 1.25rem; list-style: none; }
  .automation-shell li { position: relative; min-height: 4.5rem; padding: .65rem; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--kd-color-border-subtle); border-radius: .55rem; background: rgb(255 255 255 / 2%); }
  .automation-shell li span { color: var(--kd-color-text-accent); font-family: var(--kd-font-mono); font-size: .58rem; }
  .automation-shell li strong { font-size: .68rem; }
  .automation-shell li i { position: absolute; top: 50%; right: -1.3rem; width: 1.3rem; height: 1px; background: rgb(64 215 232 / 35%); }
  .automation-shell li:nth-child(3) i, .automation-shell li:last-child i { display: none; }
  .solution-cta { min-height: var(--kd-control-lg); padding-inline: 1rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--kd-color-border-default); border-radius: var(--kd-radius-md); background: rgb(255 255 255 / 4%); font-weight: 650; text-align: center; text-decoration: none; }
  .solution-cta:hover, .solution-cta:focus-visible { border-color: rgb(64 215 232 / 45%); background: var(--kd-color-surface-accent-subtle); }
  @media (max-width: 850px) { .solutions-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .solution-card { grid-template-rows: auto auto auto; } .portal-shell { grid-template-columns: 1fr; } .portal-shell nav { display: none; } .portal-metrics { grid-template-columns: 1fr; } .crm-controls span:nth-child(n + 3) { display: none; } .automation-shell ol { grid-template-columns: repeat(2, 1fr); } .automation-shell li:nth-child(3) i { display: block; } .automation-shell li:nth-child(2n) i { display: none; } }
</style>
