---
import { portfolio } from "../data/portfolio";

const { pricing } = portfolio;
const tierMeta = [
  { projectType: "Доработка", budget: "до 3 000 ₽" },
  { projectType: "Другое", budget: "3 000–10 000 ₽" },
  { projectType: "CRM", budget: "30 000–70 000 ₽" },
] as const;
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="section-inner">
    <header class="section-heading pricing__heading" data-reveal>
      <h2 id="pricing-title">{pricing.title}</h2>
    </header>

    <div class="pricing__grid">
      {pricing.tiers.map((tier, index) => (
        <article class:list={["pricing__card", { "pricing__card--featured": index === 1 }]} data-reveal>
          <div class="pricing__card-topline">
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {index === 1 && <small>Оптимальный старт</small>}
          </div>
          <h3>{tier.title}</h3>
          <strong class="pricing__price">{tier.price}</strong>
          <p class="pricing__label">Подходит для:</p>
          <ul>
            {tier.suitableFor.map((item) => <li>{item}</li>)}
          </ul>
          <a
            class="pricing__cta"
            href="#contact"
            data-project-type={tierMeta[index].projectType}
            data-budget={tierMeta[index].budget}
            data-service-name={tier.title}
          >
            {tier.cta}
          </a>
        </article>
      ))}
    </div>

    <aside class="pricing__ai" aria-label="Отдельная оценка AI-решения" data-reveal>
      <div>
        <span>AI · отдельное решение</span>
        <p>{pricing.aiNote}</p>
      </div>
      <a
        href="#contact"
        data-project-type="AI-консультант"
        data-budget="10 000–30 000 ₽"
        data-service-name="AI-консультант"
      >Обсудить AI-консультанта</a>
    </aside>

    <p class="pricing__disclaimer" data-reveal>{pricing.disclaimer}</p>
  </div>
</section>

<style>
  .pricing {
    border-block: 1px solid var(--kd-color-border-subtle);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 1.2%), transparent 18rem),
      var(--kd-color-background-section);
  }

  .pricing__heading {
    max-width: 48rem;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pricing__card {
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--kd-color-border-subtle);
    border-radius: var(--kd-radius-xl);
    background: var(--kd-color-background-surface);
    box-shadow: inset 0 1px rgb(255 255 255 / 3%);
  }

  .pricing__card--featured {
    border-color: rgb(0 229 255 / 28%);
    background:
      radial-gradient(circle at 100% 0%, rgb(0 229 255 / 8%), transparent 48%),
      var(--kd-color-background-surface);
  }

  .pricing__card-topline {
    min-height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--kd-color-text-accent);
    font-family: var(--kd-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pricing__card-topline small {
    font: inherit;
  }

  .pricing__card h3 {
    margin: 1.35rem 0 0;
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    letter-spacing: -0.04em;
  }

  .pricing__price {
    margin-top: 0.8rem;
    color: var(--kd-color-text-primary);
    font-size: clamp(1.45rem, 3vw, 2.05rem);
    letter-spacing: -0.035em;
  }

  .pricing__label {
    margin: 1.65rem 0 0;
    color: var(--kd-color-text-muted);
    font-size: 0.78rem;
  }

  .pricing__card ul {
    margin: 0.75rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    list-style: none;
  }

  .pricing__card li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--kd-color-text-secondary);
    line-height: 1.45;
  }

  .pricing__card li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 0.36rem;
    height: 1px;
    background: var(--kd-color-text-accent);
    content: "";
  }

  .pricing__cta,
  .pricing__ai a {
    min-height: var(--kd-control-lg);
    padding-inline: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--kd-color-border-default);
    border-radius: var(--kd-radius-md);
    color: var(--kd-color-text-primary);
    background: rgb(255 255 255 / 4%);
    font-weight: 650;
    text-align: center;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .pricing__cta {
    margin-top: auto;
  }

  .pricing__cta:hover,
  .pricing__cta:focus-visible,
  .pricing__ai a:hover,
  .pricing__ai a:focus-visible {
    border-color: rgb(0 229 255 / 42%);
    background: var(--kd-color-surface-accent-subtle);
  }

  .pricing__ai {
    margin-top: 1rem;
    padding: clamp(1.15rem, 2.8vw, 1.65rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 2rem;
    border: 1px solid rgb(0 229 255 / 20%);
    border-radius: var(--kd-radius-lg);
    background: linear-gradient(100deg, rgb(0 229 255 / 5%), transparent 52%);
  }

  .pricing__ai span {
    color: var(--kd-color-text-accent);
    font-family: var(--kd-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .pricing__ai p {
    margin: 0.45rem 0 0;
    color: var(--kd-color-text-primary);
    font-weight: 650;
    line-height: 1.45;
  }

  .pricing__ai a {
    white-space: nowrap;
  }

  .pricing__disclaimer {
    max-width: 64rem;
    margin: 1rem 0 0;
    color: var(--kd-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 850px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }

    .pricing__ai {
      grid-template-columns: 1fr;
    }

    .pricing__ai a {
      width: 100%;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing__cta,
    .pricing__ai a {
      transition: none;
    }
  }
</style>
