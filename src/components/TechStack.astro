---
import { portfolio } from "../data/portfolio";

const { tech } = portfolio;
---

<section class="tech" id="tech" aria-labelledby="tech-title">
  <div class="section-inner">
    <header class="section-heading tech__heading" data-reveal>
      <h2 id="tech-title">{tech.title}</h2>
      <p>{tech.subtitle}</p>
    </header>

    <div class="tech__grid">
      {tech.groups.map((group, index) => (
        <article class="tech__card" data-reveal>
          <header class="tech__card-heading">
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{group.category}</h3>
          </header>
          <ul aria-label={`Инструменты: ${group.category}`}>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="tech__note" data-reveal>{tech.note}</p>
  </div>
</section>

<style>
  .tech {
    position: relative;
    overflow: clip;
  }

  .tech::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, transparent 0 49.95%, rgb(255 255 255 / 2.5%) 50%, transparent 50.05%),
      radial-gradient(circle at 76% 8%, rgb(0 229 255 / 5%), transparent 30rem);
    content: "";
    pointer-events: none;
  }

  .tech__heading {
    max-width: 54rem;
  }

  .tech__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .tech__card {
    min-width: 0;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 1px solid var(--kd-color-border-subtle);
    border-radius: var(--kd-radius-lg);
    background: linear-gradient(145deg, rgb(255 255 255 / 3.4%), rgb(255 255 255 / 1.4%));
    box-shadow: inset 0 1px rgb(255 255 255 / 3%);
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .tech__card:hover {
    border-color: var(--kd-color-border-default);
    background-color: rgb(255 255 255 / 2%);
    transform: translateY(-2px);
  }

  .tech__card-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .tech__card-heading span {
    color: var(--kd-color-text-accent);
    font-family: var(--kd-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .tech__card-heading h3 {
    margin: 0;
    color: var(--kd-color-text-primary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: -0.035em;
  }

  .tech__card ul {
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }

  .tech__card li {
    max-width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--kd-color-border-subtle);
    border-radius: var(--kd-radius-full);
    color: var(--kd-color-text-secondary);
    background: rgb(5 5 5 / 42%);
    font-family: var(--kd-font-mono);
    font-size: 0.7rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .tech__note {
    max-width: 50rem;
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    border-left: 1px solid rgb(0 229 255 / 35%);
    color: var(--kd-color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .tech__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tech__grid {
      grid-template-columns: 1fr;
    }

    .tech::before {
      background: radial-gradient(circle at 100% 0%, rgb(0 229 255 / 4%), transparent 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech__card {
      transition: none;
    }

    .tech__card:hover {
      transform: none;
    }
  }
</style>
