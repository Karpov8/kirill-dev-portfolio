---
import { portfolio } from "../data/portfolio";

const { faq } = portfolio;
---

<section class="faq" id="faq" aria-labelledby="faq-title" data-faq>
  <div class="faq-inner">
    <header class="faq-heading">
      <p class="faq-kicker">FAQ</p>
      <h2 id="faq-title">{faq.title}</h2>
      <p>Коротко о старте, формате работы и возможностях проекта.</p>
    </header>

    <div class="faq-list">
      {faq.items.map((item, index) => {
        const number = String(index + 1).padStart(2, "0");
        const questionId = `faq-question-${index + 1}`;
        const answerId = `faq-answer-${index + 1}`;

        return (
          <details class="faq-item" data-reveal>
            <summary id={questionId} aria-controls={answerId} aria-expanded="false">
              <span class="faq-number" aria-hidden="true">{number}</span>
              <span class="faq-question">{item.question}</span>
              <span class="faq-marker" aria-hidden="true"></span>
            </summary>
            <div
              class="faq-answer"
              id={answerId}
              role="region"
              aria-labelledby={questionId}
            >
              <p>{item.answer}</p>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
  .faq {
    border-block: 1px solid var(--kd-color-border-subtle, rgba(255, 255, 255, 0.08));
    background: var(--kd-color-background-section, #0a0a0a);
  }

  .faq-inner {
    width: min(100% - (var(--kd-gutter, clamp(1rem, 4vw, 4rem)) * 2), var(--kd-content, 78rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(16rem, 0.62fr) minmax(0, 1.38fr);
    align-items: start;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .faq-heading {
    position: sticky;
    top: 7rem;
  }

  .faq-kicker {
    margin: 0 0 0.9rem;
    color: var(--kd-color-text-accent, #40d7e8);
    font-family: var(--kd-font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .faq-heading h2 {
    max-width: 12ch;
    margin: 0;
    color: var(--kd-color-text-primary, #f4f1ea);
    font-size: clamp(2.35rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  .faq-heading > p:last-child {
    max-width: 28rem;
    margin: 1.25rem 0 0;
    color: var(--kd-color-text-secondary, #b3b7be);
    line-height: 1.65;
  }

  .faq-list {
    border-top: 1px solid var(--kd-color-border-subtle, rgba(255, 255, 255, 0.08));
  }

  .faq-item {
    border-bottom: 1px solid var(--kd-color-border-subtle, rgba(255, 255, 255, 0.08));
  }

  .faq-item[data-reveal] {
    opacity: 1;
    transform: none;
  }

  :global(html[data-interactions-ready="true"]) .faq-item[data-reveal] {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 420ms ease,
      transform 420ms ease,
      border-color 160ms ease;
  }

  :global(html[data-interactions-ready="true"]) .faq-item[data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--kd-color-text-accent, #40d7e8) 28%, transparent);
  }

  summary {
    min-height: 5.25rem;
    padding: 1.25rem 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    color: var(--kd-color-text-primary, #f4f1ea);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-number {
    color: var(--kd-color-text-muted, #8f949d);
    font-family: var(--kd-font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .faq-question {
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .faq-marker {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--kd-color-border-default, rgba(255, 255, 255, 0.12));
    border-radius: 999px;
    color: var(--kd-color-text-secondary, #b3b7be);
    font-family: var(--kd-font-mono, monospace);
    font-size: 1rem;
  }

  .faq-marker::before {
    content: "+";
  }

  .faq-item[open] .faq-marker {
    border-color: color-mix(in srgb, var(--kd-color-text-accent, #40d7e8) 42%, transparent);
    color: var(--kd-color-text-accent, #40d7e8);
  }

  .faq-item[open] .faq-marker::before {
    content: "−";
  }

  .faq-answer {
    max-width: 46rem;
    padding: 0 3rem 1.6rem 2.55rem;
  }

  .faq-answer p {
    margin: 0;
    color: var(--kd-color-text-secondary, #b3b7be);
    line-height: 1.72;
  }

  @media (max-width: 52rem) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .faq-heading {
      position: static;
    }
  }

  @media (max-width: 30rem) {
    summary {
      gap: 0.7rem;
    }

    .faq-answer {
      padding-right: 0;
      padding-left: 1.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-interactions-ready="true"]) .faq-item[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
